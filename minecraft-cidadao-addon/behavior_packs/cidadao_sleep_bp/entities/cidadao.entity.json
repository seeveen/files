{
  "format_version": "1.20.50",
  "minecraft:entity": {
    "description": {
      "identifier": "addon:cidadao",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "addon:night_sleep": {
        "minecraft:behavior.move_to_bed": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "search_range": 32
        },
        "minecraft:behavior.sleep": {
          "priority": 1,
          "sleep_collider_height": 0.2,
          "sleep_collider_width": 1.0,
          "sleep_y_offset": 0.4,
          "timeout_cooldown": 5
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cidadao",
          "humanoid"
        ]
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:movement": {
        "value": 0.1
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "is_daytime",
              "operator": "==",
              "value": false
            },
            "event": "addon:on_night"
          },
          {
            "filters": {
              "test": "is_daytime",
              "operator": "==",
              "value": true
            },
            "event": "addon:on_day"
          }
        ]
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_stroll": {
        "priority": 9,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_look_around": {
        "priority": 10
      }
    },
    "events": {
      "addon:on_night": {
        "add": {
          "component_groups": [
            "addon:night_sleep"
          ]
        }
      },
      "addon:on_day": {
        "remove": {
          "component_groups": [
            "addon:night_sleep"
          ]
        }
      }
    }
  }
}
